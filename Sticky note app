            const selectEl = document.getElementById('quickAddTargetSelect');
            const progressLabel = document.getElementById('sheetProgressLabel');
            const progressBar = document.getElementById('sheetProgressBar');
            const navBadge = document.getElementById('navTasksBadge');

            const todoNotes = notes.filter(n => n.type === 'todo');
            let allTasks = [];

            todoNotes.forEach(note => {
                note.tasks.forEach(t => {
                    allTasks.push({
                        ...t,
                        noteId: note.id,
                        noteTitle: note.title,
                        noteColor: note.color
                    });
                });
            });

            // Vul dropdown voor Quick-Add balk
