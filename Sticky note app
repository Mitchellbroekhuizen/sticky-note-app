            switch (topperType) {
                case 'washi-striped':
                    return `<div onclick="cycleNoteTopper('${noteId}', event)" title="Tik voor andere topper" class="cursor-pointer absolute -top-3 left-1/2 -translate-x-1/2 w-24 h-6 washi-striped rounded-sm rotate-[-2deg] active:scale-110 transition-transform"></div>`;
                case 'washi-dots':
                    return `<div onclick="cycleNoteTopper('${noteId}', event)" title="Tik voor andere topper" class="cursor-pointer absolute -top-3 left-1/2 -translate-x-1/2 w-24 h-6 washi-dots rounded-sm rotate-[2deg] active:scale-110 transition-transform"></div>`;
                case 'bow':
                    return `<div onclick="cycleNoteTopper('${noteId}', event)" title="Tik voor andere topper" class="cursor-pointer absolute -top-4 left-1/2 -translate-x-1/2 text-2xl pin-topper active:scale-125 transition-transform">🎀</div>`;
                case 'heart':
                    return `<div onclick="cycleNoteTopper('${noteId}', event)" title="Tik voor andere topper" class="cursor-pointer absolute -top-4 left-1/2 -translate-x-1/2 text-2xl pin-topper active:scale-125 transition-transform">💖</div>`;
                case 'star':
                    return `<div onclick="cycleNoteTopper('${noteId}', event)" title="Tik voor andere topper" class="cursor-pointer absolute -top-4 left-1/2 -translate-x-1/2 text-2xl pin-topper active:scale-125 transition-transform">✨</div>`;
                case 'flower':
                    return `<div onclick="cycleNoteTopper('${noteId}', event)" title="Tik voor andere topper" class="cursor-pointer absolute -top-4 left-1/2 -translate-x-1/2 text-2xl pin-topper active:scale-125 transition-transform">🌸</div>`;
