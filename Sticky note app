        function renderApp() {
            renderBoardNotes();
            renderMasterTodoSheet();
            saveNotesToStorage();
        }

        /*************************************************************************
         * 7. TOUCH & POINTER DRAG-AND-DROP VOOR PIXEL 10 PRO
         *************************************************************************/
        function startStickyDrag(e, noteId) {
            if (e.button !== undefined && e.button !== 0) return;

            const note = notes.find(n => n.id === noteId);
            const cardEl = document.getElementById(`sticky-card-${noteId}`);
            if (!note || !cardEl) return;

            triggerHaptic(12);
            bringNoteToFront(noteId);

            dragData = {
                active: true,
                noteId: noteId,
                el: cardEl,
                pointerId: e.pointerId,
                startX: e.clientX,
                startY: e.clientY,
                originX: note.x,
                originY: note.y
            };

            cardEl.classList.add('dragging');
            document.addEventListener('pointermove', onStickyDragMove, { passive: false });
            document.addEventListener('pointerup', onStickyDragEnd);
            document.addEventListener('pointercancel', onStickyDragEnd);
        }

        function onStickyDragMove(e) {
            if (!dragData.active || !dragData.el) return;
            e.preventDefault();

            const dx = e.clientX - dragData.startX;
            const dy = e.clientY - dragData.startY;

            const nextX = Math.max(8, Math.min(580, dragData.originX + dx));
            const nextY = Math.max(16, Math.min(1800, dragData.originY + dy));

            dragData.el.style.left = `${nextX}px`;
            dragData.el.style.top = `${nextY}px`;

            const note = notes.find(n => n.id === dragData.noteId);
            if (note) {
                note.x = Math.round(nextX);
                note.y = Math.round(nextY);
            }
        }

        function onStickyDragEnd() {
            if (!dragData.active) return;
            if (dragData.el) {
                dragData.el.classList.remove('dragging');
            }
            dragData.active = false;
            dragData.noteId = null;
            dragData.el = null;

            document.removeEventListener('pointermove', onStickyDragMove);
            document.removeEventListener('pointerup', onStickyDragEnd);
            document.removeEventListener('pointercancel', onStickyDragEnd);

            saveNotesToStorage();
        }

        function bringNoteToFront(noteId) {
            const note = notes.find(n => n.id === noteId);
            if (!note) return;
            highestZ += 1;
            note.zIndex = highestZ;
            const el = document.getElementById(`sticky-card-${noteId}`);
            if (el) el.style.zIndex = highestZ;
        }

        /*************************************************************************
         * 8. INTERACTIES: NOTITIES, TAKEN, CONFETTI & AUTO-ALIGN
         *************************************************************************/
        function toggleFabMenu() {
            triggerHaptic(15);
            fabMenuOpen = !fabMenuOpen;
            const popover = document.getElementById('fabMenuPopover');
            const fabBtn = document.getElementById('mainFabBtn');

            if (fabMenuOpen) {
                popover.classList.remove('pointer-events-none', 'opacity-0', 'translate-y-4');
                popover.classList.add('pointer-events-auto', 'opacity-100', 'translate-y-0');
                fabBtn.classList.add('rotate-45');
            } else {
                popover.classList.add('pointer-events-none', 'opacity-0', 'translate-y-4');
                popover.classList.remove('pointer-events-auto', 'opacity-100', 'translate-y-0');
                fabBtn.classList.remove('rotate-45');
            }
        }

        function createNewSticky(type = 'todo') {
            if (fabMenuOpen) toggleFabMenu();
            triggerHaptic(20);

            // Schakel naar prikbord zodat je de nieuwe notitie meteen ziet
            if (activeTab !== 'board') switchTab('board');

            const colorKeys = Object.keys(PASTEL_PALETTE);
            const randomColor = colorKeys[Math.floor(Math.random() * colorKeys.length)];
            const randomTopper = TOPPER_STYLES[Math.floor(Math.random() * TOPPER_STYLES.length)];
            const randomTilt = (Math.random() * 3.2 - 1.6).toFixed(1);

            const boardScroll = document.getElementById('boardScrollContainer');
            const topPos = (boardScroll.scrollTop || 0) + 52;
            highestZ += 1;

            const newSticky = {
                id: 'note-' + Date.now(),
                type: type,
                title: type === 'todo' ? 'Nieuw Takenlijstje 🎀' : 'Lieve Notitie 💌',
                color: randomColor,
                topper: randomTopper,
                x: 26,
                y: topPos,
                rotation: parseFloat(randomTilt),
                zIndex: highestZ,
                tasks: type === 'todo' ? [
                    { id: 't-' + Date.now(), text: 'Mijn eerste taakje ✨', completed: false }
                ] : [],
                content: type === 'note' ? 'Schrijf hier iets liefs...' : ''
            };

            notes.push(newSticky);
            renderApp();
            showPixelToast(type === 'todo' ? 'Takenlijstje opgeprikt! 🎀' : 'Notitie opgeprikt! 💌', '🌸');
        }

        function cycleNoteTopper(noteId, e) {
            if (e) e.stopPropagation();
            triggerHaptic(15);
            const note = notes.find(n => n.id === noteId);
            if (!note) return;
            const currentIdx = TOPPER_STYLES.indexOf(note.topper);
            note.topper = TOPPER_STYLES[(currentIdx + 1) % TOPPER_STYLES.length];
            renderBoardNotes();
            saveNotesToStorage();
        }

        function setNoteColor(noteId, colorKey, e) {
            if (e) e.stopPropagation();
            triggerHaptic(12);
            const note = notes.find(n => n.id === noteId);
            if (!note) return;
            note.color = colorKey;
            renderApp();
        }

        function updateStickyTitle(noteId, newTitle) {
            const note = notes.find(n => n.id === noteId);
            if (!note) return;
            note.title = newTitle;
            renderMasterTodoSheet();
            saveNotesToStorage();
        }

        function updateStickyText(noteId, newText) {
            const note = notes.find(n => n.id === noteId);
            if (!note) return;
            note.content = newText;
            saveNotesToStorage();
        }

        function deleteStickyNote(noteId) {
            triggerHaptic(20);
            notes = notes.filter(n => n.id !== noteId);
            renderApp();
            showPixelToast('Sticky note verwijderd', '🗑️');
        }

        function addTaskFromSticky(e, noteId) {
            e.preventDefault();
            const input = e.target.querySelector('input');
            const text = input.value.trim();
            if (!text) return;

            const note = notes.find(n => n.id === noteId);
            if (!note) return;

            triggerHaptic(15);
            note.tasks.push({
                id: 't-' + Date.now() + '-' + Math.floor(Math.random() * 100),
                text: text,
                completed: false
            });

            input.value = '';
            renderApp();
            showPixelToast('Taakje toegevoegd! 🎀', '✨');
        }

        function handleQuickAddMasterTask(e) {
            e.preventDefault();
            const input = document.getElementById('quickAddInput');
            const select = document.getElementById('quickAddTargetSelect');
            const text = input.value.trim();
            if (!text) return;

            triggerHaptic(15);
            let targetNote = notes.find(n => n.id === select.value && n.type === 'todo');

            if (!targetNote) {
                highestZ += 1;
                targetNote = {
                    id: 'note-' + Date.now(),
                    type: 'todo',
                    title: 'Mijn Takenlijstje 🌷',
                    color: 'pink',
                    topper: 'bow',
                    x: 26,
                    y: 48,
                    rotation: -1.2,
                    zIndex: highestZ,
                    tasks: []
                };
                notes.push(targetNote);
            }

            targetNote.tasks.push({
                id: 't-' + Date.now(),
                text: text,
                completed: false
            });

            input.value = '';
            renderApp();
            showPixelToast(`Toegevoegd aan ${targetNote.title}`, '🌸');
        }

        function toggleTaskItem(noteId, taskId) {
            const note = notes.find(n => n.id === noteId);
            if (!note || !note.tasks) return;
            const task = note.tasks.find(t => t.id === taskId);
            if (!task) return;

            task.completed = !task.completed;
            triggerHaptic(task.completed ? 25 : 12);
            renderApp();

            // Pastel Confetti Burst wanneer een checklist sticky note 100% voltooid bereikt!
            const isAllCompleted = note.tasks.length > 0 && note.tasks.every(t => t.completed);
            if (task.completed && isAllCompleted && typeof confetti === 'function') {
                confetti({
                    particleCount: 55,
                    spread: 65,
                    origin: { y: 0.6 },
                    colors: ['#FFD1DC', '#E6E6FA', '#D4F8E8', '#FFFACD', '#F472B6']
                });
                showPixelToast('Yay! Lijstje 100% voltooid! 🎉', '💖');
            }
        }

        function removeTaskItem(noteId, taskId) {
            triggerHaptic(12);
            const note = notes.find(n => n.id === noteId);
            if (!note || !note.tasks) return;
            note.tasks = note.tasks.filter(t => t.id !== taskId);
            renderApp();
        }

        // Netjes Uitlijnen (Auto-Snap voor mobiel Pixel-scherm of breed scherm)
        function autoAlignNotesMobile() {
            triggerHaptic(20);
            const boardContainer = document.getElementById('boardScrollContainer');
            const containerWidth = boardContainer.clientWidth;
            const isWideScreen = containerWidth > 720;

            let currentY = 48;
            notes.forEach((note, index) => {
                if (isWideScreen) {
                    const col = index % 2;
                    const row = Math.floor(index / 2);
                    note.x = 32 + col * 365;
                    note.y = 48 + row * 370;
                } else {
                    note.x = Math.max(16, Math.round((containerWidth - 335) / 2));
                    note.y = currentY;
                    const estimatedHeight = note.type === 'todo' ? 275 + (note.tasks.length * 42) : 265;
                    currentY += estimatedHeight + 28;
                }
                note.rotation = index % 2 === 0 ? -1.2 : 1.2;
            });

            renderBoardNotes();
            saveNotesToStorage();
            boardContainer.scrollTo({ top: 0, behavior: 'smooth' });
            showPixelToast('Netjes uitgelijnd op je scherm! ✨', '🌷');
        }

        /*************************************************************************
         * 9. NAVIGATIE TUSSEN PRIKBORD & TAKENLIJST SHEET + VIEWPORT TOGGLE
         *************************************************************************/
        function switchTab(tabName) {
            triggerHaptic(15);
            activeTab = tabName;
            const sheet = document.getElementById('todoBottomSheet');
            const navBoard = document.getElementById('navTabBoard');
            const navTasks = document.getElementById('navTabTasks');

            if (fabMenuOpen) toggleFabMenu();

            if (tabName === 'tasks') {
                sheet.classList.remove('translate-y-full');
                sheet.classList.add('translate-y-0');
                navTasks.className = 'relative flex flex-col items-center gap-0.5 py-1 px-4 rounded-2xl transition-all text-pink-600 bg-pink-50/90 font-bold';
                navBoard.className = 'flex flex-col items-center gap-0.5 py-1 px-4 rounded-2xl transition-all text-slate-400 hover:text-pink-500 font-bold';
            } else {
                sheet.classList.add('translate-y-full');
                sheet.classList.remove('translate-y-0');
                navBoard.className = 'flex flex-col items-center gap-0.5 py-1 px-4 rounded-2xl transition-all text-pink-600 bg-pink-50/90 font-bold';
                navTasks.className = 'relative flex flex-col items-center gap-0.5 py-1 px-4 rounded-2xl transition-all text-slate-400 hover:text-pink-500 font-bold';
            }
        }

        function setTaskFilter(filter) {
            triggerHaptic(10);
            taskFilter = filter;
            ['all', 'active', 'completed'].forEach(f => {
                const btn = document.getElementById(`filterTab-${f}`);
                if (f === filter) {
                    btn.className = 'flex-1 text-xs font-bold py-1.5 rounded-xl transition-all bg-white text-pink-600 shadow-sm';
                } else {
                    btn.className = 'flex-1 text-xs font-bold py-1.5 rounded-xl transition-all text-slate-500';
                }
            });
            renderMasterTodoSheet();
        }

        function jumpToNoteOnBoard(noteId, e) {
            if (e) e.stopPropagation();
            switchTab('board');
            bringNoteToFront(noteId);
            setTimeout(() => {
                const el = document.getElementById(`sticky-card-${noteId}`);
                if (el) {
                    el.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'center' });
                    el.classList.add('ring-4', 'ring-pink-400');
                    setTimeout(() => el.classList.remove('ring-4', 'ring-pink-400'), 1300);
                }
            }, 220);
        }

        function toggleViewportMode() {
            triggerHaptic(15);
            isPixelFrameMode = !isPixelFrameMode;
            applyViewportMode();
        }

        function toggleFullScreenFromInside() {
            toggleViewportMode();
        }

        function applyViewportMode() {
            const phoneViewport = document.getElementById('phoneViewport');
            const frameBtn = document.getElementById('frameToggleBtn');
            const statusBar = document.getElementById('pixelStatusBar');

            if (isPixelFrameMode) {
                phoneViewport.classList.remove('fullscreen-mode');
                phoneViewport.classList.add('pixel-frame-mode');
                statusBar.classList.remove('hidden');
                frameBtn.textContent = '📱 Wissel naar Volledig Scherm';
            } else {
                phoneViewport.classList.remove('pixel-frame-mode');
                phoneViewport.classList.add('fullscreen-mode');
                statusBar.classList.add('hidden');
                frameBtn.textContent = '✨ Bekijk in Pixel 10 Pro Voorbeeld';
            }
        }

        function resetSampleNotes() {
            triggerHaptic(20);
            notes = JSON.parse(JSON.stringify(INITIAL_SAMPLE_NOTES));
            renderApp();
            showPixelToast('Voorbeeld-notities hersteld! 🌸', '✨');
        }

        // Real-time klok in de Pixel 10 Pro statusbalk
        function updatePixelClock() {
            const now = new Date();
            const hh = String(now.getHours()).padStart(2, '0');
            const mm = String(now.getMinutes()).padStart(2, '0');
            const clockEl = document.getElementById('pixelClock');
            if (clockEl) clockEl.textContent = `${hh}:${mm}`;
        }

        function escapeHTML(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function escapeAttr(str) {
            return String(str).replace(/"/g, '&quot;');
        }

        // Automatisch volledig scherm kiezen als je de app op een echte mobiele telefoon opent
        window.onload = () => {
            if (window.innerWidth <= 500) {
                isPixelFrameMode = false;
                document.getElementById('desktopPreviewBar').classList.add('hidden');
                applyViewportMode();
            }
            updatePixelClock();
            setInterval(updatePixelClock, 30000);
            loadNotesFromStorage();
            renderApp();
        };
    </script>
</body>
</html>
